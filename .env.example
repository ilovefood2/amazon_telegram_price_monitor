# Check all products in products.json every 5 minutes.
CHECK_INTERVAL_SECONDS=300
PRODUCTS_FILE=/app/products.json
PAGE_LOAD_WAIT_SECONDS=4

# Telegram
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_CHAT_ID_HERE

# Default repeat interval while an item remains at/below target.
# Per-product repeat_alert_hours in products.json overrides this.
# Set a product's repeat_alert_hours to 0 to disable repeat reminders.
REPEAT_ALERT_HOURS=24

STATE_FILE=/data/state.json
LOG_LEVEL=INFO

# Display container logs in Toronto local time. State timestamps stay in UTC.
TZ=America/Toronto

# Raspberry Pi / Debian Chromium paths
CHROME_BINARY=/usr/bin/chromium
CHROMEDRIVER_BINARY=/usr/bin/chromedriver
